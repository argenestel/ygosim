{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@ygosim/protocol": ["../../packages/protocol/src/index.ts"],
      "@ygosim/engine": ["../../packages/engine/src/index.ts"]
    }
  },
  "include": ["./*.ts", "../../playwright.config.ts"]
}
